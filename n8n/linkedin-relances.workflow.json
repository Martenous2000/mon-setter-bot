      "name": "IF Dry Run",
      "id": "0ca4a78d-3e0d-43dd-8dd2-964151983c2b"
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.dryRunPreview = staticData.dryRunPreview || [];\nstaticData.dryRunPreview.unshift({\n  chatId: $json.chatId,\n  message: $json.message,\n  targetStage: $json.targetStage,\n  at: new Date().toISOString(),\n});\nstaticData.dryRunPreview = staticData.dryRunPreview.slice(0, 50);\nstaticData.thisRunPreview = (staticData.thisRunPreview || 0) + 1;\nreturn [{ json: { previewed: true, chatId: $json.chatId } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        -320
      ],
      "name": "Record Preview",
      "id": "be9749a5-f629-4895-9a2c-b1a8b5458670"
    },
    {
