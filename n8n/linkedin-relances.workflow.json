      "name": "Schedule Trigger",
      "id": "0776e710-e6d9-4665-83ac-7e83ab5aac09"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-dsn",
              "name": "Unipile DSN",
              "type": "string",
              "value": "https://apiXXX.unipile.com:XXXXX"
            },
            {
              "id": "cfg-key",
              "name": "Unipile API Key",
              "type": "string",
              "value": "YOUR_UNIPILE_API_KEY"
            },
            {
              "id": "cfg-acc",
              "name": "Unipile Account ID",
              "type": "string",
              "value": "YOUR_UNIPILE_ACCOUNT_ID"
            },
            {
              "id": "cfg-me",
              "name": "My Provider ID",
              "type": "string",
              "value": "YOUR_LINKEDIN_PROVIDER_ID"
            },
            {
              "id": "cfg-dry",
              "name": "dry_run",
              "type": "boolean",
              "value": true
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1360,
        0
      ],
      "name": "Config",
      "id": "caccd047-5d21-4b11-9f63-00c1414ca957"
    },
    {
      "parameters": {
        "jsCode": "// Reset run counters at the start of every execution\nconst staticData = $getWorkflowStaticData('global');\nstaticData.thisRunSent = 0;\nstaticData.thisRunPreview = 0;\n\nconst DSN = $('Config').first().json['Unipile DSN'];\nconst APIKEY = $('Config').first().json['Unipile API Key'];\nconst ACCOUNT_ID = $('Config').first().json['Unipile Account ID'];\n\nconst now = Date.now();\nconst MIN_AGE_MS = 24 * 60 * 60 * 1000;   // must be at least 24h since last activity\nconst MAX_AGE_MS = 30 * 24 * 60 * 60 * 1000; // ignore anything older than 30 days\n\nlet cursor = null;\nlet candidates = [];\nlet pages = 0;\nconst MAX_PAGES = 15;\n\ndo {\n  let url = DSN + '/api/v1/chats?account_id=' + ACCOUNT_ID + '&limit=100';\n  if (cursor) url += '&cursor=' + encodeURIComponent(cursor);\n  const res = await this.helpers.httpRequest({\n    method: 'GET',\n    url,\n    headers: { 'X-API-KEY': APIKEY, accept: 'application/json' },\n    json: true,\n  });\n  const items = res.items || [];\n  let stop = false;\n  for (const chat of items) {\n    if (chat.type !== 0) continue; // skip group chats\n    const ts = new Date(chat.timestamp).getTime();\n    const age = now - ts;\n    if (age > MAX_AGE_MS) { stop = true; break; } // sorted desc -> everything after is even older\n    if (age >= MIN_AGE_MS) candidates.push({ chatId: chat.id });\n  }\n  cursor = res.cursor;\n  pages++;\n  if (stop) break;\n} while (cursor && pages < MAX_PAGES);\n\nreturn candidates.map(c => ({ json: c }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1120,
        0
      ],
      "name": "Fetch Candidate Chats",
      "id": "a7c7e8a9-6edd-4334-8ced-f8e88501d650"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -880,
        0
      ],
      "name": "SplitInBatches",
      "id": "7f0c4ff1-c2f5-4f80-bc89-fc81fbd44257"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json['Unipile DSN'] }}/api/v1/chats/{{ $('SplitInBatches').item.json.chatId }}/messages?limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-KEY",
              "value": "={{ $('Config').item.json['Unipile API Key'] }}"
            },
            {
              "name": "accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -640,
        -120
      ],
      "name": "Get Last Message",
      "id": "cb60c564-19f1-4ad7-b894-b36a4d41c66a"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').item.json['Unipile DSN'] }}/api/v1/chats/{{ $('SplitInBatches').item.json.chatId }}/attendees",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-KEY",
              "value": "={{ $('Config').item.json['Unipile API Key'] }}"
            },
            {
              "name": "accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -400,
        -120
      ],
      "name": "Get Attendee",
      "id": "2ca4df58-75fd-428e-8467-bea9f82c150c"
    },
    {
      "parameters": {
        "jsCode": "const chatId = $('SplitInBatches').item.json.chatId;\nconst msgRes = $('Get Last Message').item.json;\nconst attRes = $('Get Attendee').item.json;\n\nconst lastMsg = (msgRes.items || [])[0];\nconst attendee = (attRes.items || [])[0];\nconst firstName = attendee ? (attendee.name || '').trim().split(/\\s+/)[0] : '';\n\nconst staticData = $getWorkflowStaticData('global');\nstaticData.relances = staticData.relances || {};\n\nconst notEligible = { eligible: false, chatId };\n\n// If they replied since our last message (or chat is empty), nothing to relaunch -> reset tracking\nif (!lastMsg || lastMsg.is_sender !== 1) {\n  delete staticData.relances[chatId];\n  return [{ json: notEligible }];\n}\n\nif (!firstName) {\n  return [{ json: notEligible }];\n}\n\nconst rec = staticData.relances[chatId] || { stage: 0 };\nconst now = Date.now();\nconst DAY = 24 * 60 * 60 * 1000;\n\nif (rec.stage === 0) {\n  const seenTimes = Object.values(lastMsg.seen_by || {}).map(t => new Date(t).getTime());\n  if (lastMsg.seen !== 1 || seenTimes.length === 0) return [{ json: notEligible }];\n  const seenAt = Math.min(...seenTimes);\n  if (now - seenAt < DAY) return [{ json: notEligible }];\n  return [{ json: { eligible: true, chatId, message: firstName + ' ?', targetStage: 1 } }];\n}\n\nif (rec.stage === 1) {\n  if (now - (rec.relance1SentAt || 0) < 3 * DAY) return [{ json: notEligible }];\n  return [{ json: { eligible: true, chatId, message: \"J'espère que tu n'es pas trop sous l'eau \\uD83D\\uDE4F\", targetStage: 2 } }];\n}\n\nreturn [{ json: notEligible }]; // stage >= 2 : on ne relance pas une 3e fois"
      },
