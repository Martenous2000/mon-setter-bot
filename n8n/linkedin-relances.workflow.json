      "name": "Send Relance Message",
      "id": "b6622a4e-ac18-4dd0-b4d1-0ebe1324d510"
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.relances = staticData.relances || {};\nconst chatId = $('Decide Relance').item.json.chatId;\nconst targetStage = $('Decide Relance').item.json.targetStage;\nconst now = Date.now();\nconst rec = staticData.relances[chatId] || {};\nrec.stage = targetStage;\nif (targetStage === 1) rec.relance1SentAt = now;\nif (targetStage === 2) rec.relance2SentAt = now;\nstaticData.relances[chatId] = rec;\nstaticData.thisRunSent = (staticData.thisRunSent || 0) + 1;\nreturn [{ json: { updated: true, chatId, targetStage } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        -120
      ],
      "name": "Update Relance State",
      "id": "c99ee5e3-25aa-4dff-8949-066d5e80d4e3"
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst sent = staticData.thisRunSent || 0;\nconst previewed = staticData.thisRunPreview || 0;\nif (sent === 0 && previewed === 0) return [];\nconst dryRun = $('Config').first().json.dry_run;\nconst lines = [];\nlines.push('\\uD83D\\uDD01 Relances LinkedIn - passage terminé');\nif (dryRun) {\n  lines.push(previewed + ' relance(s) auraient été envoyées (mode dry_run actif, rien de réellement envoyé).');\n} else {\n  lines.push(sent + ' relance(s) réellement envoyée(s).');\n}\nreturn [{ json: { text: lines.join('\\n') } }];"
      },
