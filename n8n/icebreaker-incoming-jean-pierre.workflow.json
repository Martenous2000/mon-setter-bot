      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const response = $input.first().json;\nconst items = response.items || [];\nif (items.length === 0) return [{ json: { _noInvitations: true } }];\nconst results = [];\nfor (const inv of items) {\n  const inviter = inv.inviter || {};\n  const specifics = inv.specifics || {};\n  let publicId = inviter.inviter_public_identifier || '';\n  let profileUrl = publicId ? 'https://www.linkedin.com/in/' + publicId : '';\n  let prenom = (inviter.inviter_name || '').split(/\\\\s+/)[0] || '';\n  if (prenom) prenom = prenom.charAt(0).toUpperCase() + prenom.slice(1).toLowerCase();\n  results.push({ json: {\n    inviteId: inv.id,\n    providerId: inviter.inviter_id || '',\n    name: inviter.inviter_name || '',\n    prenom,\n    description: inviter.inviter_description || '',\n    publicIdentifier: publicId,\n    profileUrl,\n    sharedSecret: specifics.shared_secret || '',\n    accountId: 'TR0EWPZBT3eUJVrCHDM-3w',\n    _noInvitations: false\n  }});\n}\nreturn results;"
      },
