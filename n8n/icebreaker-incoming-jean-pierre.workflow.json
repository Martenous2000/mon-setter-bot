    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const invData = $('IF Has Invitations').first().json;\nconst profile = $('Scrape Profile (Unipile)').first().json || {};\nconst personaMd = $input.first().json.personaMd || '';\n\nconst headline = profile.headline || invData.description || '';\nconst bio = headline;\n\nconst systemPrompt = 'Voici les instructions ICP completes pour ce compte (le persona est partage entre plusieurs comptes qui ciblent la meme population, applique le meme critere) :\\n\\n' + personaMd + '\\n\\nBase sur la section ICP ci-dessus, ce lead correspond-il a la cible (dirigeant B2B, effectif >=5, francophone) ? Reponds UNIQUEMENT par OUI ou NON.';\n\nlet icpResult = 'non';\ntry {\n  const resp = await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'https://openrouter.ai/api/v1/chat/completions',\n    headers: { 'Authorization': 'Bearer YOUR_OPENROUTER_API_KEY', 'Content-Type': 'application/json' },\n    body: JSON.stringify({ model: 'anthropic/claude-haiku-4.5', messages: [ { role: 'system', content: systemPrompt }, { role: 'user', content: 'Nom: ' + invData.name + '\\nBio/Headline: ' + bio } ], temperature: 0.1, max_tokens: 10 }),\n    json: true,\n  });\n  const answer = (resp.choices[0].message.content || '').trim().toUpperCase();\n  icpResult = answer.includes('OUI') ? 'oui' : 'non';\n} catch(e) { icpResult = 'non'; }\n\nreturn [{ json: { ...invData, headline, bio, personaMd, action: icpResult === 'oui' ? 'accept' : 'skip' } }];"
      },
