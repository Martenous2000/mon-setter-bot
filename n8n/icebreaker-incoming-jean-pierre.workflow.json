    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const providerId = $('Parse Invitations').first().json.providerId;\nconst accountId = $('Parse Invitations').first().json.accountId;\nlet cursor = null;\nlet hasMessages = false;\nlet pages = 0;\ndo {\n  const url = 'https://YOUR_UNIPILE_DSN/api/v1/chats?account_id=' + accountId + '&limit=100' + (cursor ? '&cursor=' + encodeURIComponent(cursor) : '');\n  const resp = await this.helpers.httpRequest({ method: 'GET', url, headers: { 'X-API-KEY': 'YOUR_UNIPILE_API_KEY' }, json: true });\n  const chats = resp.items || [];\n  for (const chat of chats) {\n    const attendeeId = String(chat.attendee_provider_id || '');\n    if (attendeeId === providerId) { hasMessages = true; break; }\n    const attendees = chat.attendees || [];\n    for (const a of attendees) { if (String(a.provider_id || '') === providerId) { hasMessages = true; break; } }\n    if (hasMessages) break;\n  }\n  cursor = resp.cursor || null;\n  pages++;\n} while (cursor && !hasMessages && pages < 20);\nreturn [{ json: { ...$('Parse Invitations').first().json, shouldContinue: !hasMessages } }];"
      },
