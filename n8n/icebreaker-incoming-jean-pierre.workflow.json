    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const contactData = $('Classify Lead (GitHub ICP)').first().json;\nconst prenom = contactData.prenom || '';\nconst providerId = contactData.providerId;\nconst profileUrl = contactData.profileUrl || '';\nconst headline = contactData.headline || '';\nconst name = contactData.name || '';\nconst personaMd = contactData.personaMd || '';\nconst reglesMd = $('Fetch Persona + Regles GitHub').first().json.reglesMd || '';\n\nlet posts = [];\ntry {\n  const raw = $('Scrape Posts (Unipile)').first().json;\n  posts = raw.items || raw.posts || (Array.isArray(raw) ? raw : []);\n  if (!Array.isArray(posts)) posts = [];\n} catch(e) { posts = []; }\n\nconst usablePosts = posts.filter(p => (p.text || p.content || '').trim().length > 20).slice(0, 3);\nconst hasPosts = usablePosts.length > 0;\n\nlet userContent;\nif (hasPosts) {\n  const postsText = usablePosts.map((p, i) => 'Post ' + (i+1) + ': ' + (p.text || p.content || '').substring(0, 600)).join('\\n\\n');\n  userContent = 'Prenom du lead : ' + prenom + '\\nCeci est une demande de connexion entrante qu\\'on vient d\\'accepter.\\nDerniers posts LinkedIn disponibles (choisis le plus adapte a une reaction sincere) :\\n' + postsText;\n} else {\n  userContent = 'Prenom du lead : ' + prenom + '\\nCeci est une demande de connexion entrante qu\\'on vient d\\'accepter.\\nAUCUN post trouve malgre recherche sur 10 posts recents. Headline: ' + (headline || '(vide)') + '\\nRemonte ce cas (pas de Type 2), redige un message minimal Type 1 base sur la headline en dernier recours.';\n}\n\nconst systemPrompt = 'Tu es Jean-Pierre Martin sur LinkedIn. Voici ton persona complet :\\n\\n' + personaMd + '\\n\\nVoici les regles strictes obligatoires pour rediger un icebreaker (Type 1 uniquement) :\\n\\n' + reglesMd + '\\n\\nApplique ces regles A LA LETTRE : format \"Helllo [prenom]\" en debut de message, 2-3 lignes maximum, jamais de Type 2, jamais de formule generique, tutoiement, 1 emoji maximum (jamais 😄), jamais de tiret cadratin, jamais de guillemets autour du message final, question courte et specifique en fin de message.\\n\\nReponds UNIQUEMENT avec le message final, rien d\\'autre.';\n\nlet icebreaker = '';\ntry {\n  const resp = await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'https://openrouter.ai/api/v1/chat/completions',\n    headers: { 'Authorization': 'Bearer YOUR_OPENROUTER_API_KEY', 'Content-Type': 'application/json' },\n    body: JSON.stringify({ model: 'anthropic/claude-opus-4', messages: [ { role: 'system', content: systemPrompt }, { role: 'user', content: userContent } ], temperature: 0.5, max_tokens: 150 }),\n    json: true,\n  });\n  icebreaker = (resp.choices[0].message.content || '').trim();\n  if ((icebreaker.startsWith('\"') && icebreaker.endsWith('\"'))) icebreaker = icebreaker.slice(1, -1);\n} catch(e) {\n  icebreaker = 'Helllo ' + prenom + ', je viens de voir ton profil, ca me parle bien ce que tu fais. Tu te concentres sur quoi en ce moment';\n}\n\nreturn [{ json: { accountId: contactData.accountId, providerId, prenom, headline, profileUrl, icebreaker, hasPosts, name } }];"
      },
