    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const invData = $('IF Has Invitations').first().json;\nconst profile = $('Scrape Profile (Unipile)').first().json || {};\nconst personaMd = $input.first().json.personaMd || '';\nconst headline = profile.headline || invData.description || '';\nconst about = profile.summary || '';\nconst bio = headline + (about ? '\\n' + about : '');\n\nconst systemPrompt = 'You are qualifying a LinkedIn lead. Below is the full targeting persona (ICP) instructions for this account. Follow them exactly to decide if this lead matches.\\n\\n' + personaMd + '\\n\\nBased on the ICP section above, reply ONLY with OUI or NON (French words expected by the pipeline, ignore the English content when answering this specific instruction).';\n\nlet icpResult = 'non';\ntry {\n  const resp = await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'https://openrouter.ai/api/v1/chat/completions',\n    headers: { 'Authorization': 'Bearer YOUR_OPENROUTER_API_KEY', 'Content-Type': 'application/json' },\n    body: JSON.stringify({ model: 'anthropic/claude-haiku-4.5', messages: [ { role: 'system', content: systemPrompt }, { role: 'user', content: 'Name: ' + invData.name + '\\nBio/Headline: ' + bio } ], temperature: 0.1, max_tokens: 10 }),\n    json: true,\n  });\n  const answer = (resp.choices[0].message.content || '').trim().toUpperCase();\n  icpResult = answer.includes('OUI') ? 'oui' : 'non';\n} catch(e) { icpResult = 'non'; }\n\nreturn [{ json: { ...invData, headline, about, bio, personaMd, action: icpResult === 'oui' ? 'accept' : 'skip' } }];"
      },
