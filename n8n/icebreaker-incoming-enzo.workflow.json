    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const contactData = $('Classify Lead (GitHub ICP)').first().json;\nconst prenom = contactData.prenom || '';\nconst providerId = contactData.providerId;\nconst profileUrl = contactData.profileUrl || '';\nconst headline = contactData.headline || '';\nconst name = contactData.name || '';\nconst personaMd = contactData.personaMd || '';\n\n// Unipile returns a relative age string like '1d', '3h', '2w', '1mo', not an absolute date.\nfunction relativeAgeToDays(v) {\n  if (!v) return 9999;\n  const m = String(v).match(/^(\\\\d+)\\\\s*(h|d|w|mo|y)/i);\n  if (!m) return 9999;\n  const n = parseInt(m[1], 10);\n  const unit = m[2].toLowerCase();\n  if (unit === 'h') return n / 24;\n  if (unit === 'd') return n;\n  if (unit === 'w') return n * 7;\n  if (unit === 'mo') return n * 30;\n  if (unit === 'y') return n * 365;\n  return 9999;\n}\n\nlet posts = [];\ntry {\n  const raw = $('Scrape Posts (Unipile)').first().json;\n  posts = raw.items || raw.posts || (Array.isArray(raw) ? raw : []);\n  if (!Array.isArray(posts)) posts = [];\n} catch(e) { posts = []; }\n\nconst recentPosts = posts.filter(p => {\n  const ageDays = relativeAgeToDays(p.date);\n  const text = (p.text || p.content || '').trim();\n  return ageDays <= 14 && text.length > 20;\n}).sort((a,b) => relativeAgeToDays(a.date) - relativeAgeToDays(b.date)).slice(0, 1);\n\nconst hasPosts = recentPosts.length > 0;\nlet userContent;\nif (hasPosts) {\n  const postText = (recentPosts[0].text || recentPosts[0].content || '').substring(0, 600);\n  userContent = 'Lead first name: ' + prenom + '\\nRecent LinkedIn post to react to:\\n' + postText;\n} else {\n  userContent = 'Lead first name: ' + prenom + '\\nNo recent post available. Headline/bio: ' + (headline || '(empty)');\n}\n\nconst systemPrompt = 'Below is the full persona and messaging instructions for this LinkedIn account (Enzo Vidiella). Follow the Icebreaker section EXACTLY (format, tone, language, forbidden words/punctuation). If a recent post is provided, use the Type 1 format (react to the post). If no post is provided, write a short opener in the same English tone reformulating their activity from the headline/bio in a similarly casual, direct style, ending with a short open question, respecting the same forbidden list (no em dash, no exclamation marks unless explicitly allowed, English only).\\n\\n' + personaMd + '\\n\\nReply ONLY with the final icebreaker message, nothing else.';\n\nlet icebreaker = '';\ntry {\n  const resp = await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'https://openrouter.ai/api/v1/chat/completions',\n    headers: { 'Authorization': 'Bearer YOUR_OPENROUTER_API_KEY', 'Content-Type': 'application/json' },\n    body: JSON.stringify({ model: 'anthropic/claude-opus-4', messages: [ { role: 'system', content: systemPrompt }, { role: 'user', content: userContent } ], temperature: 0.5, max_tokens: 150 }),\n    json: true,\n  });\n  icebreaker = (resp.choices[0].message.content || '').trim();\n  if ((icebreaker.startsWith('\"') && icebreaker.endsWith('\"'))) icebreaker = icebreaker.slice(1, -1);\n} catch(e) {\n  icebreaker = 'Hello ' + prenom + ', thanks for connecting. Would love to learn more about what you are building.';\n}\n\nreturn [{ json: { accountId: contactData.accountId, providerId, prenom, headline, profileUrl, icebreaker, hasPosts, name } }];"
      },
